# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Recommended default for local development: point these at the TEST Supabase project
# (test_patron_cup), not production. Get the values from the Supabase dashboard ->
# Project Settings -> API, using the legacy anon/service_role keys (not the newer
# sb_publishable_/sb_secret_ format -- see AGENTS.md's Environments table).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only -- bypasses Row Level Security. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
