# Copy to .env.e2e.local and fill in real values. .env.e2e.local is gitignored.
# This file is ONLY read by playwright.config.ts -- it is never read by Next.js itself and
# is deliberately separate from .env.local (which may point at other environments; see
# AGENTS.md's Environments table).

# --- Target selection -------------------------------------------------------
# 'deployed' (default, hits E2E_BASE_URL) or 'local' (builds+starts the app locally).
E2E_TARGET=deployed

# Override the deployed base URL if ever needed; defaults to https://test.patron-cup.com.
# E2E_BASE_URL=https://test.patron-cup.com

# --- Test account credentials (test Supabase project only; never prod) ------
# Get these from your password manager -- never commit real values.
E2E_ADMIN_EMAIL=test-admin@example.com
E2E_ADMIN_PASSWORD=
E2E_COMMITTEE_EMAIL=test-committee@example.com
E2E_COMMITTEE_PASSWORD=
E2E_PLAYER_EMAIL=test-player@example.com
E2E_PLAYER_PASSWORD=

# --- Test Supabase project credentials (test_patron_cup, never prod) -------
# Used for two things, in both E2E_TARGET modes:
#   1. Direct admin-client cleanup/assertions in e2e/support/supabaseAdminE2E.ts.
#   2. Only when E2E_TARGET=local: injected into the spawned `next start` process by
#      playwright.config.ts's webServer.env, which intentionally does NOT read .env.local,
#      to guarantee local-mode E2E runs can never hit production data.
# Use the SAME test_patron_cup project values described in AGENTS.md's Environments table.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
